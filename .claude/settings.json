{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "PowerShell(git push)",
      "PowerShell(git push *)",
      "Bash(gh pr merge *)",
      "PowerShell(gh pr merge *)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "PowerShell(vercel *)",
      "PowerShell(npx vercel *)",
      "Bash(npm publish *)",
      "PowerShell(npm publish *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "PowerShell(ssh *)",
      "PowerShell(scp *)",
      "Bash(docker *)",
      "PowerShell(docker *)",
      "Read(**/.env)",
      "Read(**/.env*)",
      "Edit(**/.env)",
      "Edit(**/.env*)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Edit(//**/.env)",
      "Edit(//**/.env.*)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
