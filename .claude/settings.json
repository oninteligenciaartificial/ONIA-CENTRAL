{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.onia/**)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main)",
      "Bash(git push *refs/heads/main *)",
      "Bash(git push *+main)",
      "Bash(git push *+main *)",
      "PowerShell(git push * main)",
      "PowerShell(git push * main *)",
      "PowerShell(git push *:main)",
      "PowerShell(git push *:main *)",
      "PowerShell(git push *refs/heads/main)",
      "PowerShell(git push *refs/heads/main *)",
      "PowerShell(git push *+main)",
      "PowerShell(git push *+main *)"
    ],
    "ask": [
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "PowerShell(vercel *)",
      "PowerShell(npx vercel *)",
      "PowerShell(ssh *)",
      "PowerShell(scp *)"
    ]
  }
}
