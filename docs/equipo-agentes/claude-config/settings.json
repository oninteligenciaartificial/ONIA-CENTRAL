{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "PowerShell(git push)",
      "PowerShell(git push *)",
      "Bash(gh pr merge *)",
      "PowerShell(gh pr merge *)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "PowerShell(vercel *)",
      "PowerShell(npx vercel *)",
      "Bash(npm publish *)",
      "PowerShell(npm publish *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "PowerShell(ssh *)",
      "PowerShell(scp *)",
      "Bash(docker *)",
      "PowerShell(docker *)",
      "Read(**/.env)",
      "Read(**/.env*)",
      "Edit(**/.env)",
      "Edit(**/.env*)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Edit(//**/.env)",
      "Edit(//**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.sh"
            ],
            "onFailure": "block",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.ps1"
            ],
            "onFailure": "block",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "-c",
              "cat \"$CLAUDE_PROJECT_DIR/.claude/reglas-criticas.md\""
            ]
          }
        ]
      }
    ]
  }
}
