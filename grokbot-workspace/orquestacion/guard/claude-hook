#!/usr/bin/env python3
"""PreToolUse: nunca ejecuta el comando; exit 2 impide que Claude lo ejecute."""
import json
import os
import runpy
import sys
try:
    evento = json.load(sys.stdin)
    texto = evento['tool_input']['command']
    guard = runpy.run_path('/workspace/orquestacion/guard/onia-guard')
    rc = guard['check']('onia-llm-comando', texto)
    if not rc and os.environ.get('ONIA_LLM_SOLO_BORRADORES') == '1':
        rc, _ = runpy.run_path('/workspace/orquestacion/guard/loop-comando')['comprobar'](texto)
    sys.exit(2 if rc else 0)
except (ValueError, KeyError, TypeError, OSError):
    print('onia-guard: no se pudo validar el comando; bloqueado.', file=sys.stderr)
    sys.exit(2)
