    {
      "parameters": {
        "jsCode": "// Elige a qué comentarios responder. No envía nada: solo arma la lista.\n// Lee la configuración del nodo \"Configuración\" y la cuenta del nodo \"Leer mi cuenta\".\nconst cfg = $('Configuración').first().json;\nconst cuenta = $('Leer mi cuenta').first().json;\nconst memoria = $getWorkflowStaticData('global');\nif (!Array.isArray(memoria.procesados)) memoria.procesados = [];\nconst yaVistos = new Set(memoria.procesados);\n\n// Saca acentos y pasa a minúsculas, para que \"ÍA\", \"ia\" e \"Ia\" cuenten igual.\nconst normalizar = (t) => String(t || '')\n  .normalize('NFD').replace(/[̀-ͯ]/g, '')\n  .toLowerCase();\nconst lista = (t) => String(t || '').split(',').map((p) => normalizar(p).trim()).filter(Boolean);\n\nconst palabras = lista(cfg.PALABRAS_CLAVE);\nconst testers = lista(cfg.TESTERS).map((u) => u.replace(/^@/, ''));\nconst modo = normalizar(cfg.MODO).trim();\nconst desde = Date.parse(cfg.SOLO_DESDE);\nif (Number.isNaN(desde) || !/^\\d{4}-\\d{2}-\\d{2}T/.test(String(cfg.SOLO_DESDE))) {\n  // Sin una fecha válida no se sabe desde cuándo contestar: se corta, para no descartar comentarios en silencio.\n  throw new Error('SOLO_DESDE no es una fecha válida. Usá el formato 2026-11-06T00:00:00-04:00');\n}\nconst maximo = Number(cfg.MAX_POR_CORRIDA) || 20;\nconst SIETE_DIAS_MENOS_MARGEN = (7 * 24 - 6) * 3600 * 1000; // Meta deja responder hasta 7 días; dejamos 6 horas de margen.\nconst ahora = Date.now();\nconst miUsuario = normalizar(cuenta.username);\n\n// La palabra tiene que estar sola, no dentro de otra (\"ia\" no cuenta en \"familia\").\nconst tienePalabra = (texto) => {\n  const t = normalizar(texto);\n  return palabras.some((p) => {\n    const escapada = p.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n    return new RegExp('(^|[^a-z0-9])' + escapada + '($|[^a-z0-9])').test(t);\n  });\n};\n\nconst salida = [];\nfor (const item of $input.all()) {\n  const c = item.json;\n  if (!c || !c.id || yaVistos.has(c.id)) continue;\n  const usuario = normalizar(c.username || (c.from && c.from.username));\n  const cuando = Date.parse(c.timestamp);\n  const motivo =\n    usuario === miUsuario ? 'es un comentario propio' :\n    !tienePalabra(c.text) ? 'no tiene la palabra clave' :\n    !(cuando >= desde) ? 'es anterior a SOLO_DESDE' :\n    ahora - cuando > SIETE_DIAS_MENOS_MARGEN ? 'pasaron casi 7 días' :\n    null;\n  if (motivo) {\n    // Los que no tienen la palabra no se guardan: si el comentario se edita no vuelve a llegar igual, y así la memoria queda chica.\n    if (motivo !== 'no tiene la palabra clave') yaVistos.add(c.id);\n    continue;\n  }\n  if (salida.length >= maximo) break; // el resto queda para la próxima vuelta\n  const enviar = modo === 'real' || (modo === 'solo_testers' && testers.includes(usuario));\n  const mensaje = String(cfg.TEXTO_DM || '')\n    .split('{usuario}').join(c.username || '')\n    .split('{link}').join(cfg.LINK || '');\n  salida.push({ json: {\n    accion: enviar ? 'enviar' : 'simular',\n    modo,\n    ig_user_id: cuenta.user_id,\n    comment_id: c.id,\n    usuario: c.username || '',\n    comentario: c.text || '',\n    publicacion: (c.media && c.media.id) || '',\n    fecha_comentario: c.timestamp,\n    mensaje,\n  } });\n  yaVistos.add(c.id);\n}\n\n// Se guarda solo lo último, para que la memoria no crezca sin fin.\nmemoria.procesados = Array.from(yaVistos).slice(-3000);\nreturn salida;\n"
      },
